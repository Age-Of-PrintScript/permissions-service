@owner = b73d8cc1-aac6-4d6b-8ab4-c20ec5afe72b
@editor = a1c965b0-8786-4476-b8e5-7148df276583
@viewer = 9a4c1f69-d04a-47a4-8fdd-4017da523dee

### Compartir: 123 (owner) le da acceso viewer a 456
POST http://localhost:8080/snippets/124/members
X-User-Id: 123
Content-Type: application/json

{
    "userId": "456",
    "roleId": "{{viewer}}"
}

### Cambiar rol de 456 a editor
PUT http://localhost:8080/snippets/124/members/456
X-User-Id: 123
Content-Type: application/json

{
    "roleId": "{{editor}}"
}

### Revocar a 456
DELETE http://localhost:8080/snippets/124/members/456
X-User-Id: 123
